<Window x:Class="StockManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StockManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 -->
        <Border Grid.ColumnSpan="3"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="비품 관리 시스템"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="#2C3E50"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBox Width="220"
                             Height="34"
                             Margin="0,0,10,0"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Text="검색어 입력"/>
                    <ComboBox x:Name="ComboCate" Width="120"
                              Height="34"
                              Margin="0,0,10,0"/>
                    <Button 
                            Content="조회"
                            Width="80"
                            Height="34"
                            Background="#3498DB"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 왼쪽 메뉴 -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#2C3E50">
            <StackPanel Margin="15,25">
                <Button Content="전체 비품"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="#34495E"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button Content="재고 부족"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button Content="입출고 내역"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 가운데 목록 -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="20"
                Background="White"
                CornerRadius="8"
                Padding="15">
            <DockPanel>
                <TextBlock Text="비품 목록"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#333333"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,15"/>

                <DataGrid x:Name="gridresult"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="비품명" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="분류"  Binding="{Binding Category}"  Width="100" />
                        <DataGridTextColumn Header="수량"  Binding="{Binding Quantity}"  Width="70" />
                        <DataGridTextColumn Header="위치" Binding="{Binding Location}"  Width="120" />
                        <DataGridTextColumn Header="상태" Binding="{Binding Status}"  Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 오른쪽 상세 -->
        <Border Grid.Row="1"
                Grid.Column="2"
                Margin="0,20,20,20"
                Background="White"
                CornerRadius="8"
                Padding="20">
            <StackPanel>
                <TextBlock Text="비품 정보"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="비품명"/>
                <TextBox Height="34"   VerticalContentAlignment="Center" Margin="0,5,0,15" />

                <TextBlock Text="분류"/>
                <ComboBox x:Name="ComboCate2" VerticalContentAlignment="Center" Height="34" Margin="0,5,0,15"/>

                <TextBlock Text="수량"/>
                <TextBox Height="34" VerticalContentAlignment="Center" Margin="0,5,0,15"/>

                <TextBlock Text="위치"/>
                <TextBox Height="34" VerticalContentAlignment="Center" Margin="0,5,0,15"/>

                <TextBlock Text="메모"/>
                <TextBox Height="80"
                         VerticalContentAlignment="Center"
                         Margin="0,5,0,20"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>

                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center">

                    <Button Content="비품 추가"
            Width="70"
            Height="32"
            Margin="0,0,8,0"
            Background="#95A5A6"
            Foreground="White"
            BorderThickness="0"/>

                    <Button Content="저장"
            Width="70"
            Height="32"
            Margin="0,0,8,0"
            Background="#3498DB"
            Foreground="White"
            BorderThickness="0"/>

                    <Button Content="삭제"
            Width="70"
            Height="32"
            Background="#E74C3C"
            Foreground="White"
            BorderThickness="0"/>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
